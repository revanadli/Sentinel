# JKN Sentinel — Environment Variables
# Salin file ini ke: backend/.env
# JANGAN commit file ini ke git (sudah ada di .gitignore)

# ── Database (XAMPP default) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sentinel_db
DB_USER=root
DB_PASS=

# ── Google Gemini API ──
# Dapatkan gratis di: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── App ──
APP_ENV=local
APP_DEBUG=true
GEMINI_MODEL=gemini-2.0-flash-exp

